{
  "dependencies": {
    "next": "^15.5.28",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tesseract.js": "^5.1.1",
    "zod": "^4.6.7"
  },
  "description": "AI gate automation for ports — OCR license plates & container numbers, verify against appointment slots. Demo built for the Port of Casablanca.",
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.28",
    "postcss": "^8.5.30",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.6.0",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=18.18"
  },
  "name": "gatewatch",
  "private": true,
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "next lint --max-warnings 0"
  },
  "version": "1.0.0",
  "overrides": {
    "next": {
      "postcss": "$postcss"
    }
  }
}
